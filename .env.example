# ==========================================
# CakeCart Production & Local Environment Config
# ==========================================

# Neon PostgreSQL connection string (pooled connection for Vercel Functions)
DATABASE_URL="postgres://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/cakecart?sslmode=require"

# Direct connection for migrations (unpooled)
DIRECT_URL="postgres://user:password@ep-sample.us-east-2.aws.neon.tech/cakecart?sslmode=require"

# Vercel Blob Read/Write Token for cake photos & customer reference images
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# JWT Secret for Session Cookies (min 32 chars)
AUTH_SECRET="cakecart_super_secure_jwt_session_secret_2026_production"

# Vercel Cron Secret for hold cleanup endpoint
CRON_SECRET="cakecart_cron_cleanup_secret_key_9988"

# Payment Provider Test Mode
PAYMENT_PROVIDER="test_gateway"
STRIPE_SECRET_KEY="sk_test_sample_key_only_on_server"
STRIPE_WEBHOOK_SECRET="whsec_sample_secret_only_on_server"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_sample_key"

# App URL for base URLs and webhook callbacks
NEXT_PUBLIC_APP_URL="http://localhost:3000"
